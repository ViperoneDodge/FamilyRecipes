rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Amministratore dell'app (stessa email di AppState.adminEmail).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'appmyfleetmanager@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // L'amministratore legge le ricette di tutti (collectionGroup).
    match /{path=**}/recipes/{recipeId} {
      allow read: if isAdmin();
    }

    match /books/{bookId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function adminsOf(d) {
        return d.get('admins', []).concat([d.ownerUid]);
      }

      function isGroupAdmin() {
        return isMember()
          && (resource.data.get('personal', false) == true || request.auth.uid in adminsOf(resource.data));
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Nomi/email dei membri: chi entra o esce può cambiare solo la propria voce.
      function onlyOwnEmail() {
        return request.resource.data.get('memberEmails', {})
          .diff(resource.data.get('memberEmails', {})).affectedKeys().hasOnly([request.auth.uid]);
      }

      // Documento inesistente: nessun dato da mostrare (serve per creare il proprio libro).
      // Libro personale: solo il proprietario. Gruppo: i membri e chi ha il codice invito per entrare.
      allow get: if isAdmin()
        || isMember()
        || (signedIn() && (resource == null || resource.data.get('personal', false) != true));
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);

      // Tipi dei campi che l'app legge: un gruppo con campi sbagliati bloccherebbe l'elenco gruppi dei membri.
      function wellTyped() {
        return request.resource.data.get('name', '') is string
          && request.resource.data.get('memberEmails', {}) is map
          && request.resource.data.get('admins', []) is list
          && request.resource.data.get('viewers', []) is list;
      }

      allow create: if signedIn()
        && wellTyped()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        // Libro personale: ha l'ID dell'utente. Gruppo: ID di 10 caratteri (come newId(10)),
        // così nessuno può occupare in anticipo l'ID del libro personale di un altro.
        && (request.resource.data.get('personal', false) == true
          ? bookId == request.auth.uid
          : (bookId.size() == 10 && bookId != request.auth.uid));

      allow update: if wellTyped() && (isAdmin()
        // Amministratore del gruppo: non può cambiare il creatore, togliere admin o membri admin.
        || (isGroupAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('personal', false) == resource.data.get('personal', false)
          && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []))
          && request.resource.data.members.hasAll(adminsOf(resource.data)))
        // Un membro può solo uscire dal gruppo.
        || (isMember()
          && request.auth.uid != resource.data.ownerUid
          && changed().hasOnly(['members', 'memberEmails', 'viewers', 'admins'])
          && onlyOwnEmail()
          // Esattamente i valori di prima meno sé stessi: uscendo non si può aggiungere nessuno,
          // nemmeno sé stessi tra gli admin.
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.get('admins', []).toSet() == resource.data.get('admins', []).toSet().difference([request.auth.uid].toSet())
          && request.resource.data.get('viewers', []).toSet() == resource.data.get('viewers', []).toSet().difference([request.auth.uid].toSet()))
        // Chi entra con il codice invito si aggiunge solo come "sola lettura".
        || (signedIn()
          && !isMember()
          && resource.data.get('personal', false) != true
          && changed().hasOnly(['members', 'memberEmails', 'viewers'])
          && onlyOwnEmail()
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.viewers
          // Chi entra non può togliere gli altri dalla sola lettura.
          && request.resource.data.viewers.hasAll(resource.data.get('viewers', []))
          && request.resource.data.viewers.removeAll(resource.data.get('viewers', [])).hasOnly([request.auth.uid])));

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      function book() {
        return get(/databases/$(database)/documents/books/$(bookId)).data;
      }

      function canRead() {
        return isAdmin() || (signedIn() && request.auth.uid in book().members);
      }

      function canWrite() {
        return isAdmin() || (signedIn()
          && request.auth.uid in book().members
          && (request.auth.uid == book().ownerUid
            || request.auth.uid in book().get('admins', [])
            || !(request.auth.uid in book().get('viewers', []))));
      }

      match /recipes/{recipeId} {
        allow read: if canRead();
        allow write: if canWrite();
      }

      // Foto delle ricette (JPEG in base64, una per documento).
      match /photos/{photoId} {
        allow read: if canRead();
        allow write: if canWrite() && (request.resource == null || request.resource.data.b64.size() < 1000000);
      }
    }
  }
}
