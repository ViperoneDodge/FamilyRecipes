rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Amministratore dell'app (stessa email di AppState.adminEmail).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'appmyfleetmanager@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // L'amministratore legge le ricette di tutti (collectionGroup).
    match /{path=**}/recipes/{recipeId} {
      allow read: if isAdmin();
    }

    match /books/{bookId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function adminsOf(d) {
        return d.get('admins', []).concat([d.ownerUid]);
      }

      function isGroupAdmin() {
        return isMember()
          && (resource.data.get('personal', false) == true || request.auth.uid in adminsOf(resource.data));
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (request.resource.data.personal != true || bookId == request.auth.uid);

      allow update: if isAdmin()
        // Amministratore del gruppo: non può cambiare il creatore, togliere admin o membri admin.
        || (isGroupAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []))
          && request.resource.data.members.hasAll(adminsOf(resource.data)))
        // Un membro può solo uscire dal gruppo.
        || (isMember()
          && request.auth.uid != resource.data.ownerUid
          && changed().hasOnly(['members', 'memberEmails', 'viewers', 'admins'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
          && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []).removeAll([request.auth.uid]))
          && request.resource.data.get('viewers', []).hasAll(resource.data.get('viewers', []).removeAll([request.auth.uid])))
        // Chi entra con il codice invito si aggiunge solo come "sola lettura".
        || (signedIn()
          && !isMember()
          && resource.data.get('personal', false) != true
          && changed().hasOnly(['members', 'memberEmails', 'viewers'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.viewers
          && request.resource.data.viewers.removeAll(resource.data.get('viewers', [])).hasOnly([request.auth.uid]));

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      function book() {
        return get(/databases/$(database)/documents/books/$(bookId)).data;
      }

      function canRead() {
        return isAdmin() || (signedIn() && request.auth.uid in book().members);
      }

      function canWrite() {
        return isAdmin() || (signedIn()
          && request.auth.uid in book().members
          && (request.auth.uid == book().ownerUid
            || request.auth.uid in book().get('admins', [])
            || !(request.auth.uid in book().get('viewers', []))));
      }

      match /recipes/{recipeId} {
        allow read: if canRead();
        allow write: if canWrite();
      }

      // Foto delle ricette (JPEG in base64, una per documento).
      match /photos/{photoId} {
        allow read: if canRead();
        allow write: if canWrite() && (request.resource == null || request.resource.data.b64.size() < 1000000);
      }
    }
  }
}
